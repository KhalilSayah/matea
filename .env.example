# MATEA — variables d'environnement.
#
# À reporter dans Vercel : Project → Settings → Environment Variables.
# Coche les trois environnements (Production, Preview, Development).
#
# Ce fichier est un modèle : il ne contient aucune vraie valeur et peut
# rester dans le dépôt. Un fichier .env, lui, est ignoré par git.
#
# Tant que ces variables sont absentes, le site tourne quand même : il
# bascule en mode local et garde tout dans le navigateur du visiteur.


# ---------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------

# L'URL du projet.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# La clé « service_role », PAS la clé « anon ».
# Elle contourne les politiques RLS : elle ne doit jamais apparaître
# dans le navigateur, jamais dans le dépôt, jamais dans une capture.
# Elle n'est lue que par les fonctions de /api, côté serveur.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx


# ---------------------------------------------------------------------
# Back office
# ---------------------------------------------------------------------

# Le mot de passe de /admin. Il est comparé côté serveur, à temps
# constant, et ne descend jamais dans le code de la page.
# Prends quelque chose de long : c'est la seule chose qui garde ton
# catalogue et les coordonnées de tes clients.
ADMIN_PASSWORD=change-moi-par-une-longue-phrase


# ---------------------------------------------------------------------
# Optionnel
# ---------------------------------------------------------------------

# Nombre de bâtons par doypack. Le serveur refuse les sachets plus
# remplis que ça. Doit rester cohérent avec packSize dans
# assets/js/config.js, qui pilote l'affichage. Défaut : 10
# PACK_SIZE=10

# Préfixe des références de commande : MT-3F9K2Q. Défaut : MT
# ORDER_PREFIX=MT

# Nom du bucket Supabase Storage pour les images de parfums.
# Il est créé par supabase/schema.sql. Défaut : products
# STORAGE_BUCKET=products
